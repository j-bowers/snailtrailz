{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snailtrailz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",

  // Served at snailtrailz.bowcloud.dev (custom domain; Cloudflare manages the DNS record and
  // certificate). Declared here so `wrangler deploy` matches the dashboard instead of drifting.
  // workers_dev is false because the *.workers.dev address would expose the account name.
  "routes": [
    { "pattern": "snailtrailz.bowcloud.dev", "custom_domain": true }
  ],
  "workers_dev": false,

  // BowCloud fonts, served from this Worker's own origin (no third-party font host). Static assets
  // are matched before the Worker runs, and public/ holds nothing but fonts, so every other path
  // ("/", "/json", "/health", 404s) still reaches src/index.js.
  "assets": { "directory": "./public" },

  // Workers Logs. Captures errors and invocation metadata so you can debug a
  // broken deploy. It does NOT capture visitor IPs unless you log them
  // yourself — so don't. Set to false if you'd rather keep nothing at all.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },

  // Abuse control. 60 requests per minute per IP is generous for a human and
  // uncomfortable for a script. Period must be 10 or 60 — those are the only
  // values the binding accepts.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
